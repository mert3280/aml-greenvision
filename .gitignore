data/Plant_leave_diseases_dataset_without_augmentation/

# Generated artifacts — track key outputs, ignore raw intermediate files.
artifacts/*
!artifacts/.gitkeep
!artifacts/class_names.json
!artifacts/splits.json
!artifacts/reports
!artifacts/reports/*

# Model checkpoints — precious, regenerated by training (mnist_cnn.pt stays tracked).
models/*.pt
!models/mnist_cnn.pt

# MLflow tracking store (append-only).
mlruns/

# Python / tooling.
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Next.js dashboard — dependencies and build output.
dashboard/node_modules/
dashboard/.next/
dashboard/.env*.local
